# ---------------------------------------------------------------
# Configuración de Conexión a MongoDB Atlas (Cluster ElVolcan)
# ---------------------------------------------------------------

# Cadena de conexión a MongoDB Atlas (Cloud M0 Gratis) o instancia local:
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/el_volcan_db?retryWrites=true&w=majority

# Nombre de la base de datos NoSQL (definida en volcan_mongodb_setup.js)
MONGO_DB=el_volcan_db
