# ===============================================================
# Configuración Backend El Volcán — Variables de Entorno (EC2 / Local)
# ===============================================================

# 1. Zona horaria oficial (Santiago de Chile)
TZ=America/Santiago

# 2. Conexión a MongoDB Atlas Cloud (M0 Gratis) — ms-catalogo, ms-venta, ms-auth
# Reemplaza <db_username>, <db_password> y <cluster> con tus credenciales de Atlas
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/el_volcan_db?retryWrites=true&w=majority
MONGO_DB=el_volcan_db

# 2b. Conexión a Oracle Cloud Autonomous Database (Always Free, mTLS Wallet) — ms-usuario, ms-inventario, ms-pago
# Descarga la Instance Wallet desde OCI y descomprímela en backend/wallet/ (ignorado por Git).
# Alias típico en backend/wallet/tnsnames.ora: <nombre_db>_tp
ORACLE_TNS_ALIAS=elvolcandb_tp
ORACLE_WALLET_HOST_DIR=./wallet
ORACLE_USUARIO_USER=ELVOLCAN_USUARIO
ORACLE_USUARIO_PASSWORD=<PASSWORD_USUARIO>
ORACLE_INVENTARIO_USER=ELVOLCAN_INVENTARIO
ORACLE_INVENTARIO_PASSWORD=<PASSWORD_INVENTARIO>
ORACLE_PAGO_USER=ELVOLCAN_PAGO
ORACLE_PAGO_PASSWORD=<PASSWORD_PAGO>

# 3. Configuración CORS para el API Gateway (puerto 8080)
# Agrega aquí la URL pública de tu frontend en Render (separadas por coma si son varias)
# Ejemplo: https://el-volcan-frontend.onrender.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://tu-frontend.onrender.com,http://localhost:5173,*

# 4. Seguridad y Tokens JWT
JWT_SECRET=ElVolcanSecretKeyParaAutenticacionMicroserviciosJWT2026Segura123456
JWT_EXPIRATION=86400000

# 5. Descubrimiento Eureka (Interno de Docker)
EUREKA_URL=http://eureka-server:8761/eureka/

# 6. Sincronización automática de IP pública dinámica de AWS EC2 (AWS Academy)
# Al prender la instancia EC2, backend/scripts/ec2-sync-ip.sh detecta la nueva IP vía IMDSv2,
# actualiza automáticamente VITE_API_URL en Render (sin tocar VITE_CARTO_API_KEY) y redespliega el frontend.
# - RENDER_API_KEY: Render Dashboard -> Account Settings -> API Keys -> Create API Key (rnd_...)
# - RENDER_SERVICE_ID: ID del Static Site en la URL de Render (ej: srv-xxxxxxxxxxxxxxxxxxxx)
RENDER_API_KEY=
RENDER_SERVICE_ID=
RENDER_API_ENV_KEY=VITE_API_URL
PUBLIC_API_SCHEME=http
PUBLIC_API_PORT=8080
PUBLIC_API_PATH=/api/v1

# 7. (Opcional) Sincronización automática con DuckDNS si usas dominio dinámico/HTTPS
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=
