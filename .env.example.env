# ---------------------------------------------------------------
# Configuración de Conexión a MongoDB Atlas (Cluster ElVolcan)
# ---------------------------------------------------------------

# Reemplaza <db_username> y <db_password> por el usuario y contraseña de tu base de datos en Atlas:
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Nombre de la base de datos (definida en volcan_mongodb_setup.js)
MONGO_DB=el_volcan_db

# Inicializar e importar automáticamente los 6 JSON si la BD está vacía (true/false)
AUTO_SEED_MONGODB=true
