# ===============================================================
# Configuración Backend El Volcán — Variables de Entorno (EC2 / Local)
# ===============================================================

# 1. Conexión a MongoDB Atlas Cloud (M0 Gratis)
# Reemplaza <db_username>, <db_password> y <cluster> con tus credenciales de Atlas
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/el_volcan_db?retryWrites=true&w=majority
MONGO_DB=el_volcan_db

# 2. Configuración CORS para el API Gateway (puerto 8080)
# Agrega aquí la URL pública de tu frontend en Render (separadas por coma si son varias)
# Ejemplo: https://el-volcan-frontend.onrender.com,http://localhost:5173
CORS_ALLOWED_ORIGINS=https://tu-frontend.onrender.com,http://localhost:5173,*

# 3. Seguridad y Tokens JWT
JWT_SECRET=ElVolcanSecretKeyParaAutenticacionMicroserviciosJWT2026Segura123456
JWT_EXPIRATION=86400000

# 4. Descubrimiento Eureka (Interno de Docker)
EUREKA_URL=http://eureka-server:8761/eureka/
